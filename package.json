{
  "name": "travel-journal",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @travel-journal/server dev\" \"pnpm --filter @travel-journal/client dev\"",
    "build": "pnpm --filter @travel-journal/shared build && pnpm --filter @travel-journal/server build && pnpm --filter @travel-journal/client build",
    "lint": "eslint packages && tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json",
    "test": "pnpm --filter @travel-journal/server test && pnpm --filter @travel-journal/client test",
    "e2e": "node e2e/run-e2e.mjs",
    "e2e:ui": "node e2e/run-e2e.mjs --ui",
    "e2e:ci": "E2E_ENV_FILE=.env.ci node e2e/run-e2e.mjs",
    "typecheck": "tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "mongodb-memory-server",
      "msw",
      "@playwright/test",
      "protobufjs",
      "sharp",
      "ssh2"
    ],
    "overrides": {
      "protobufjs": "^7.5.5",
      "@types/node@>=25": "24.19.2",
      "typescript": "6.0.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.1",
    "typescript": "6.0.3"
  }
}
